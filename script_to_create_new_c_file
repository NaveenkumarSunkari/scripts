#Usage: Add this code to .bashrc ,then do $source .bashrc . Then open any file with .c extention with vimm command: Ex: $vimm Hello_world.c
vimm() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: openvimfile <filename>"
        return 1
    fi

    FILE="$1"

    # Check if the filename ends with .c extension
    if [[ "$FILE" != *.c ]]; then
        echo "Error: The filename must have a .c extension."
        return 1
    fi

    # Create the file and write the C code if it doesn't exist
    if [ ! -f "$FILE" ]; then
        cat <<EOL > "$FILE"
#include<stdio.h>
int main(void)
{

}
EOL
    fi

    # Open the file with Vim
    vim "$FILE"
}

coden() {
    if [ "$#" -lt 1 ]; then
        echo "Usage: coden <filename> [array|string]"
        return 1
    fi

    FILE="$1"
    MODE="$2"   # optional second argument

    # Check if the filename ends with .c extension
    if [[ "$FILE" != *.c ]]; then
        echo "Error: The filename must have a .c extension."
        return 1
    fi

    # Create the file and write the C code if it doesn't exist
    if [ ! -f "$FILE" ]; then
        case "$MODE" in
            array)
                # Minimal VLA array code
                cat <<EOL > "$FILE"
#include <stdio.h>

int main(void) {
    int n;
    printf("Enter size of array: ");
    scanf("%d", &n);

    int arr[n];  // Variable Length Array
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Array elements:\\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\\n");

    //Implement logic here

    return 0;
}
EOL
                ;;
            string)
                # Minimal VLA string code
                cat <<EOL > "$FILE"
#include <stdio.h>

int main(void) {
    int n;
    printf("Enter length of string: ");
    scanf("%d", &n);

    char str[n + 1];  // VLA string (+1 for null terminator)
    printf("Enter a string: ");
    scanf("%s", str);

    printf("You entered: %s\\n", str);

    //Implement logic here

    return 0;
}
EOL
                ;;
            *)
                # Default minimal C code
                cat <<EOL > "$FILE"
#include <stdio.h>

int main(void) {
    return 0;
}
EOL
                ;;
        esac
    fi

    # Open the file with VS Code
    code "$FILE"
}

# Add above code to .bashrc and do $source .bashrc
